<header class="bg-red-500 text-white shadow-lg">
  <nav class="container mx-auto max-w-6xl p-4 flex flex-wrap items-center justify-between gap-6">
    <a href="/" class="text-xl font-bold">airbnb</a>
    <ul class="flex flex-wrap items-center gap-2 bg-white p-2 rounded-lg shadow-md">
      <% if (currentPage !== 'login' && currentPage !== 'signup') { %>
        <li>
          <a
            href="/homes"
            class="px-4 py-2 rounded-md text-sm font-semibold transition <%= currentPage === 'Home' ? 'bg-red-400 text-white' : 'text-gray-700 hover:bg-red-300' %>"
            >Homes-List</a
          >
        </li>
        <li>
          <a
            href="/favourites"
            class="px-4 py-2 rounded-md text-sm font-semibold transition <%= currentPage === 'favourites' ? 'bg-red-400 text-white' : 'text-gray-700 hover:bg-red-300' %>"
            >Favourites</a
          >
        </li>
        <li>
          <a
            href="/bookings"
            class="px-4 py-2 rounded-md text-sm font-semibold transition <%= currentPage === 'bookings' ? 'bg-red-400 text-white' : 'text-gray-700 hover:bg-red-300' %>"
            >Bookings</a
          >
        </li>
        <li>
          <a
            href="/host/host-home-list"
            class="px-4 py-2 rounded-md text-sm font-semibold transition <%= currentPage === 'host-homes' ? 'bg-red-400 text-white' : 'text-gray-700 hover:bg-red-300' %>"
            >Host Homes</a
          >
        </li>
        <li>
          <a
            href="/host/add-home"
            class="px-4 py-2 rounded-md text-sm font-semibold transition <%= currentPage === 'addHome' ? 'bg-red-400 text-white' : 'text-gray-700 hover:bg-red-300' %>"
            >Add Home</a
          >
        </li>
      <% } %>
      <% if (!isLoggedIn) { %>
        <li>
          <a
            href="/signup"
            class="px-4 py-2 rounded-md text-sm font-semibold transition <%= currentPage === 'signup' ? 'bg-red-400 text-white' : 'text-gray-700 hover:bg-red-300' %>"
            >Signup</a
          >
        </li>
        <li>
          <a
            href="/login"
            class="px-4 py-2 rounded-md text-sm font-semibold transition <%= currentPage === 'login' ? 'bg-red-400 text-white' : 'text-gray-700 hover:bg-red-300' %>"
            >Login</a
          >
        </li>
      <% } else { %>
        <li>
          <form action="/logout" method="POST">
            <button
              type="submit"
              class="px-4 py-2 rounded-md text-sm font-semibold transition text-gray-700 hover:bg-red-300"
              >Logout</button
            >
          </form>
        </li>
      <% } %>
    </ul>
  </nav>
</header>